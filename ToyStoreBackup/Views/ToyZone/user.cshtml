@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.css" />

    <title>Đăng nhập - ToyZone</title>
    <link rel="stylesheet"
          href="~/Content/MyContent/user.css" />
</head>
<body>
    <header class="home-header">
        <h1 class="logo">
            <a href="~/ToyZone/HomeView"><img class="anh-logo" src="~/Content/My image/98582e94c3e94c5c83ae526757ad003b.jpg" /></a>
        </h1>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" placeholder="Tìm kiếm">
        </div>
        <ul class="icon-header">
            <li class="tele-phone">
                <span><i class="fa-solid fa-phone-flip"></i> 02877770049</span>
            </li>
            <li class="icon">
                <a href="~/ToyZone/user"><i class="fa-solid fa-user"></i></a>
            </li>
            <li class="icon">
                <a href="~/ToyZone/Cart"><i class="fa-solid fa-cart-shopping"></i></a>
            </li>

        </ul>
    </header>
    <nav class="nav">
        <a href="#">Hàng Mới Về</a>
        <a href="#">Ô Tô</a>
        <a href="#">Xe Chuyên Dụng</a>
        <a href="#">Mô Tô</a>
        <a href="#">Máy Bay</a>
        <a href="#">Blind Box</a>
        <a href="#">Gấu Bông</a>
        <a href="#">Figure</a>
    </nav>

    <main class="main">
        <div class="login-card">
            <h2>ĐĂNG NHẬP</h2>
            <form id="loginForm">
                <div class="form-group">
                    <span class="icon"><i class="fa-regular fa-envelope"></i></span>
                    <input type="email" id="email" placeholder="Email" required>
                </div>
                <div class="form-group">
                    <span class="icon"><i class="fa-solid fa-lock"></i></span>
                    <input type="password" id="password" placeholder="Mật khẩu" required>
                </div>
                <button type="submit" class="btn-login">ĐĂNG NHẬP</button>
            </form>
            <div class="links">
                <a href="#">Quên mật khẩu?</a> hoặc <a href="#">Đăng ký</a>
            </div>
            <div class="divider">Hoặc đăng nhập với</div>
            <div class="social-btns">
                <button class="btn-google">Đăng nhập Google</button>
                <button class="btn-facebook">Đăng nhập Facebook</button>
            </div>
        </div>
    </main>

    <section class="footer-social">
        <h4>★ SOCIAL ★</h4>
        <div class="social-icons">
            <a href="#" class="fb"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#" class="ig"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" class="yt"><i class="fa-brands fa-youtube"></i></a>
        </div>
    </section>

    <section class="partners">
        <h4>★ ĐỐI TÁC ★</h4>
        <div class="partner-logos">
            <span style="color:#0033a0">TAKARA TOMY</span>
            <span style="color:#00a651">UGREEN</span>
            <span style="color:#f7941d">JisuLife</span>
            <span style="color:#e30613">LEGO</span>
            <span style="color:#e60012">POP MART</span>
        </div>
    </section>
    <footer>
        <div class="footer-content">

            <div class="footer-column">
                <h3>Thông Tin Công Ty</h3>
                <ul>
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Thông Tin Liên Hệ</a></li>
                    <li><a href="#">Tuyển Dụng</a></li>
                    <li><a href="#">Câu Chuyện Thương Hiệu</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Chính Sách</h3>
                <ul>
                    <li><a href="#">Chương Trình Tích Điểm</a></li>
                    <li><a href="#">Chính Sách Đổi Trả Hàng</a></li>
                    <li><a href="#">Chính Sách Vận Chuyển</a></li>
                    <li><a href="#">Chính Sách Giao Hàng</a></li>
                    <li><a href="#">Chính Sách Bảo Mật</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Hỗ Trợ Khách Hàng</h3>
                <ul>
                    <li><a href="#">Phương Thức Thanh Toán</a></li>
                    <li><a href="#">Thanh Toán Trả Góp</a></li>
                    <li><a href="#">Hỏi Đáp</a></li>
                    <li><a href="#">Gửi Góp Ý, Khiếu Nại</a></li>
                </ul>
            </div>

        </div>

        <div class="footer-bottom">
            <p>Copyright © 2026</p>
        </div>
    </footer>

    <script>
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;

            if (!email || !password) {
                alert('Vui lòng nhập đầy đủ thông tin!');
                return;
            }

            // Giả lập đăng nhập
            alert('Đăng nhập thành công với email: ' + email);
            // window.location.href = '/dashboard';
        });
    </script>
</body>
</html>